extends SceneTree
const P=preload("res://scripts/debug/apex_perf_trace_0657.gd")
func _initialize()->void:
	assert(not P.enabled)
	assert(P.begin()==0)
	P.end(&"off",1)
	P.count(&"off")
	assert(P.sections.is_empty() and P.counters.is_empty())
	P.set_enabled(true)
	P.reset({"seed":6557})
	P.add_sample(&"test",1000)
	P.add_sample(&"test",3000)
	var s:Dictionary=P.snapshot()
	assert(s.sections.test.calls==2 and s.sections.test.mean_ms==2.0 and s.sections.test.max_ms==3.0)
	s.sections.test.calls=900
	assert(P.snapshot().sections.test.calls==2)
	P.set_enabled(false)
	var frozen:=JSON.stringify(P.sections)
	P.add_sample(&"test",9000)
	assert(JSON.stringify(P.sections)==frozen)
	assert(P.export_json("user://perf_unit.json")==OK)
	assert(JSON.parse_string(FileAccess.get_file_as_string("user://perf_unit.json")).sections.test.calls==2)
	assert(P.export_json("/missing-apex0657/report.json")!=OK)
	P.reset()
	P.set_enabled(true)
	for i in range(1000):
		P.add_sample(StringName(str(i)),1)
		P.count(StringName(str(i)))
	assert(P.sections.size()==64 and P.counters.size()==64)
	P.set_enabled(false)
	P.reset()
	print("PERF_UNIT_PASS default off, aggregates, export, errors, reset, bounded storage")
	quit()
