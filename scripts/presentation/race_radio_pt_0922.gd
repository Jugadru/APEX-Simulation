static func translate(words: String) -> String:
	var source: String = words
	var prefix: String = ""
	if source.begins_with("Same issue. "):
		source = source.trim_prefix("Same issue. ")
		prefix = "O mesmo problema. "
	var suffix: String = ""
	var scheduled: int = source.rfind(" Lap ")
	if scheduled >= 0 and source.ends_with(" remains booked; no change made."):
		var digits: String = source.substr(scheduled + 5).split(" ")[0]
		if digits.is_valid_int():
			suffix = " A volta %d continua marcada; sem alteração." % int(digits)
			source = source.substr(0, scheduled)
	elif source.ends_with(" No new stop has been scheduled."):
		source = source.trim_suffix(" No new stop has been scheduled.")
		suffix = " Nenhuma nova parada foi agendada."
	if PHRASES.has(source):
		return prefix + str(PHRASES[source]) + suffix
	# A dynamic lap may be inserted into a known original phrase; never
	# translate an unknown string into a guessed sporting assertion.
	for template in PHRASES:
		var marker: int = str(template).find("%d")
		if marker < 0:
			continue
		var head: String = str(template).substr(0, marker)
		var tail: String = str(template).substr(marker + 2)
		if not source.begins_with(head) or not source.ends_with(tail):
			continue
		var value: String = source.substr(head.length(), source.length() - head.length() - tail.length())
		if value.is_valid_int():
			return prefix + (str(PHRASES[template]) % int(value)) + suffix
	return ""
